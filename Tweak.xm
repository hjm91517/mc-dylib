// Tweak.xm - Minecraft Bedrock iOS 辅助插件（悬浮窗版）
// 功能：可拖动悬浮球(MC图标)、材质注入开关、音乐播放控制、网易云登录 WebView

#import <Foundation/Foundation.h>
#import <UIKit/UIKit.h>
#import <WebKit/WebKit.h>
#import <AVFoundation/AVFoundation.h>
#import "fishhook.h"

@class MCUIHandler;

// 内嵌 MC 图标（base64）
static NSString *const kMCIconBase64 = @"";

// ============================================================
// 1. 音频与全局状态
// ============================================================
static AVAudioPlayer *gMusicPlayer = nil;
static float gMusicVolume = 0.2f;
static BOOL gTextureEnabled = YES;
static NSString *gCurrentSongURL = nil;

// 面板控件引用
static UIWindow *gOverlayWindow = nil;
static UIButton *gFloatingButton = nil;
static UIView *gPanelView = nil;
static UISegmentedControl *gSegment = nil;
static UIView *gTexturePage = nil;
static UIView *gMusicPage = nil;
static UIView *gNetEasePage = nil;
static UIButton *gPlayBtn = nil;
static UISlider *gVolumeSlider = nil;
static WKWebView *gNetEaseWeb = nil;
static UILabel *gStatusLabel = nil;

// ============================================================
// 2. 音频会话
// ============================================================
static void setupAudioSession() {
    AVAudioSession *s = [AVAudioSession sharedInstance];
    NSError *e = nil;
    [s setCategory:AVAudioSessionCategoryPlayback
        withOptions:AVAudioSessionCategoryOptionMixWithOthers
              error:&e];
    [s setActive:YES error:&e];
}

static void playAudioWithUrl(NSString *urlStr) {
    if (gMusicPlayer) { [gMusicPlayer stop]; gMusicPlayer = nil; }
    NSURL *url = [NSURL URLWithString:urlStr];
    NSError *e = nil;
    gMusicPlayer = [[AVAudioPlayer alloc] initWithContentsOfURL:url error:&e];
    if (e) { NSLog(@"[MCPlugin] player err: %@", e); return; }
    gMusicPlayer.volume = gMusicVolume;
    gMusicPlayer.numberOfLoops = -1;
    [gMusicPlayer prepareToPlay];
    [gMusicPlayer play];
    gCurrentSongURL = urlStr;
    dispatch_async(dispatch_get_main_queue(), ^{
        gStatusLabel.text = [NSString stringWithFormat:@"播放中 · 音量 %.0f%%", gMusicVolume*100];
    });
}

static void togglePlay() {
    if (!gMusicPlayer) {
        // 默认播放一首示例（网易云外链，可在代码里改）
        playAudioWithUrl(@"https://music.163.com/song/media/outer/url?id=347230.mp3");
        return;
    }
    if (gMusicPlayer.isPlaying) {
        [gMusicPlayer pause];
    } else {
        [gMusicPlayer play];
    }
}

// ============================================================
// 3. 材质注入 (fishhook fopen)
// ============================================================
static FILE *(*orig_fopen)(const char *, const char *) = NULL;

static FILE *my_fopen(const char *path, const char *mode) {
    if (!gTextureEnabled) return orig_fopen(path, mode);
    if (!path) return orig_fopen(path, mode);
    NSString *ps = [NSString stringWithUTF8String:path];
    if ([ps containsString:@"renderer/"] || [ps containsString:@"textures/"] || [ps containsString:@".material.bin"]) {
        NSString *docs = [NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES) firstObject];
        NSString *base = [docs stringByAppendingPathComponent:@"CustomTextures"];
        NSString *rel = ps;
        NSRange r = [ps rangeOfString:@"renderer/"];
        if (r.location != NSNotFound) rel = [ps substringFromIndex:r.location];
        NSString *newPath = [base stringByAppendingPathComponent:rel];
        if ([[NSFileManager defaultManager] fileExistsAtPath:newPath]) {
            return orig_fopen([newPath UTF8String], mode);
        }
    }
    return orig_fopen(path, mode);
}

static void setupTextureHook() {
    struct rebinding rb[] = {{"fopen", (void *)my_fopen, (void **)&orig_fopen}};
    rebind_symbols(rb, 1);
}

// ============================================================
// 4. 悬浮窗 UI
// ============================================================
static UIImage *MCIcon() {
    static UIImage *img = nil;
    static dispatch_once_t once;
    dispatch_once(&once, ^{
        NSData *d = [[NSData alloc] initWithBase64EncodedString:kMCIconBase64 options:0];
        img = [UIImage imageWithData:d];
    });
    return img;
}

static void buildPanel();
static void togglePanel();

static void setupFloatingWindow() {
    CGRect screen = [UIScreen mainScreen].bounds;
    gOverlayWindow = [[UIWindow alloc] initWithFrame:screen];
    gOverlayWindow.windowLevel = UIWindowLevelAlert + 1;
    gOverlayWindow.backgroundColor = [UIColor clearColor];
    gOverlayWindow.rootViewController = [UIViewController new];
    gOverlayWindow.hidden = NO;

    // 悬浮球
    CGFloat sz = 60;
    gFloatingButton = [UIButton buttonWithType:UIButtonTypeCustom];
    gFloatingButton.frame = CGRectMake(20, 120, sz, sz);
    [gFloatingButton setImage:MCIcon() forState:UIControlStateNormal];
    gFloatingButton.imageView.contentMode = UIViewContentModeScaleAspectFit;
    gFloatingButton.layer.cornerRadius = sz/2;
    gFloatingButton.clipsToBounds = YES;
    gFloatingButton.layer.shadowColor = [UIColor blackColor].CGColor;
    gFloatingButton.layer.shadowOpacity = 0.4;
    gFloatingButton.layer.shadowRadius = 6;
    gFloatingButton.layer.shadowOffset = CGSizeMake(0,3);

    // 拖动
    UIPanGestureRecognizer *pan = [[UIPanGestureRecognizer alloc]
        initWithTarget:[MCUIHandler shared] action:@selector(handlePan:)];
    [gFloatingButton addGestureRecognizer:pan];

    [gOverlayWindow addSubview:gFloatingButton];
    buildPanel();
}

// 通过一个 trampoline 类处理事件（rootViewController 无法直接自定义方法）
@interface MCUIHandler : NSObject
+ (instancetype)shared;
- (void)handleTap;
- (void)handlePan:(UIPanGestureRecognizer *)g;
@end

@implementation MCUIHandler
+ (instancetype)shared { static MCUIHandler *h; static dispatch_once_t o; dispatch_once(&o, ^{ h=[MCUIHandler new]; }); return h; }
- (void)handleTap { togglePanel(); }
- (void)handlePan:(UIPanGestureRecognizer *)g {
    UIButton *b = gFloatingButton;
    CGPoint t = [g translationInView:gOverlayWindow];
    CGPoint c = CGPointMake(b.center.x + t.x, b.center.y + t.y);
    CGFloat m = 30;
    c.x = MAX(m, MIN(gOverlayWindow.bounds.size.width-m, c.x));
    c.y = MAX(m, MIN(gOverlayWindow.bounds.size.height-m, c.y));
    b.center = c;
    [g setTranslation:CGPointZero inView:gOverlayWindow];
    if (g.state == UIGestureRecognizerStateEnded) {
        [UIView animateWithDuration:0.25 delay:0 usingSpringWithDamping:0.7 initialSpringVelocity:0.5 options:0 animations:^{
            b.center = CGPointMake(c.x < gOverlayWindow.bounds.size.width/2 ? 45 : gOverlayWindow.bounds.size.width-45, c.y);
        } completion:nil];
    }
}
@end

// 把 target 换成 handler
static void wireButtons() {
    [gFloatingButton addTarget:[MCUIHandler shared] action:@selector(handleTap) forControlEvents:UIControlEventTouchUpInside];
}

static void buildPanel() {
    CGFloat pw = 300, ph = 380;
    CGRect screen = [UIScreen mainScreen].bounds;
    gPanelView = [[UIView alloc] initWithFrame:CGRectMake((screen.size.width-pw)/2, screen.size.height/2-ph/2-40, pw, ph)];
    gPanelView.backgroundColor = [UIColor colorWithWhite:0.12 alpha:0.97];
    gPanelView.layer.cornerRadius = 18;
    gPanelView.clipsToBounds = YES;
    gPanelView.alpha = 0;
    gPanelView.transform = CGAffineTransformMakeScale(0.85, 0.85);

    // 标题
    UILabel *title = [[UILabel alloc] initWithFrame:CGRectMake(0, 14, pw, 24)];
    title.text = @"MC 助手";
    title.textColor = [UIColor whiteColor];
    title.font = [UIFont boldSystemFontOfSize:17];
    title.textAlignment = NSTextAlignmentCenter;
    [gPanelView addSubview:title];

    // 关闭按钮
    UIButton *close = [UIButton buttonWithType:UIButtonTypeSystem];
    close.frame = CGRectMake(pw-36, 10, 26, 26);
    [close setTitle:@"✕" forState:UIControlStateNormal];
    [close setTitleColor:[UIColor lightGrayColor] forState:UIControlStateNormal];
    [close addTarget:[MCUIHandler shared] action:@selector(handleTap) forControlEvents:UIControlEventTouchUpInside];
    close.tag = 999;
    [gPanelView addSubview:close];

    // 分段控件
    gSegment = [[UISegmentedControl alloc] initWithItems:@[@"材质", @"音乐", @"网易云"]];
    gSegment.frame = CGRectMake(16, 48, pw-32, 30);
    gSegment.selectedSegmentIndex = 0;
    [gSegment addTarget:[MCUIHandler shared] action:@selector(segChanged) forControlEvents:UIControlEventValueChanged];
    [gPanelView addSubview:gSegment];

    // ---- 材质页 ----
    gTexturePage = [[UIView alloc] initWithFrame:CGRectMake(16, 90, pw-32, ph-110)];
    UILabel *t1 = [[UILabel alloc] initWithFrame:CGRectMake(0, 10, pw-32, 40)];
    t1.text = @"材质注入开关\n开启后将 fopen 重定向到 Documents/CustomTextures";
    t1.numberOfLines = 0; t1.textColor = [UIColor lightTextColor]; t1.font = [UIFont systemFontOfSize:13];
    [gTexturePage addSubview:t1];
    UISwitch *sw = [[UISwitch alloc] initWithFrame:CGRectMake(20, 90, 50, 30)];
    sw.on = gTextureEnabled;
    [sw addTarget:[MCUIHandler shared] action:@selector(texSwitch:) forControlEvents:UIControlEventValueChanged];
    [gTexturePage addSubview:sw];
    UILabel *swLab = [[UILabel alloc] initWithFrame:CGRectMake(80, 92, 150, 26)];
    swLab.text = @"已开启"; swLab.textColor=[UIColor whiteColor]; swLab.font=[UIFont systemFontOfSize:14];
    swLab.tag = 888;
    [gTexturePage addSubview:swLab];
    [gPanelView addSubview:gTexturePage];

    // ---- 音乐页 ----
    gMusicPage = [[UIView alloc] initWithFrame:CGRectMake(16, 90, pw-32, ph-110)];
    gPlayBtn = [UIButton buttonWithType:UIButtonTypeSystem];
    gPlayBtn.frame = CGRectMake((pw-32-70)/2, 20, 70, 70);
    [gPlayBtn setTitle:@"▶️" forState:UIControlStateNormal];
    gPlayBtn.titleLabel.font = [UIFont systemFontOfSize:34];
    gPlayBtn.backgroundColor = [UIColor colorWithRed:0.2 green:0.6 blue:0.3 alpha:1.0];
    gPlayBtn.layer.cornerRadius = 35;
    [gPlayBtn setTitleColor:[UIColor whiteColor] forState:UIControlStateNormal];
    [gPlayBtn addTarget:[MCUIHandler shared] action:@selector(playToggle) forControlEvents:UIControlEventTouchUpInside];
    [gMusicPage addSubview:gPlayBtn];
    UILabel *vLab = [[UILabel alloc] initWithFrame:CGRectMake(20, 110, 60, 20)];
    vLab.text = @"音量"; vLab.textColor=[UIColor lightTextColor];
    [gMusicPage addSubview:vLab];
    gVolumeSlider = [[UISlider alloc] initWithFrame:CGRectMake(70, 108, pw-32-90, 24)];
    gVolumeSlider.value = gMusicVolume;
    [gVolumeSlider addTarget:[MCUIHandler shared] action:@selector(volumeChanged:) forControlEvents:UIControlEventValueChanged];
    [gMusicPage addSubview:gVolumeSlider];
    gStatusLabel = [[UILabel alloc] initWithFrame:CGRectMake(0, 150, pw-32, 40)];
    gStatusLabel.text = @"未播放"; gStatusLabel.textColor=[UIColor lightTextColor];
    gStatusLabel.font=[UIFont systemFontOfSize:13]; gStatusLabel.numberOfLines=0;
    gStatusLabel.textAlignment = NSTextAlignmentCenter;
    [gMusicPage addSubview:gStatusLabel];
    gMusicPage.hidden = YES;
    [gPanelView addSubview:gMusicPage];

    // ---- 网易云页 ----
    gNetEasePage = [[UIView alloc] initWithFrame:CGRectMake(16, 90, pw-32, ph-110)];
    UILabel *nLab = [[UILabel alloc] initWithFrame:CGRectMake(0, 0, pw-32, 30)];
    nLab.text = @"在下方网页登录网易云音乐"; nLab.textColor=[UIColor lightTextColor]; nLab.font=[UIFont systemFontOfSize:13];
    [gNetEasePage addSubview:nLab];
    WKWebViewConfiguration *cfg = [[WKWebViewConfiguration alloc] init];
    gNetEaseWeb = [[WKWebView alloc] initWithFrame:CGRectMake(0, 32, pw-32, ph-110-32) configuration:cfg];
    [gNetEaseWeb loadRequest:[NSURLRequest requestWithURL:[NSURL URLWithString:@"https://music.163.com/"]]];
    [gNetEasePage addSubview:gNetEaseWeb];
    gNetEasePage.hidden = YES;
    [gPanelView addSubview:gNetEasePage];

    [gOverlayWindow addSubview:gPanelView];
}

static BOOL gPanelOpen = NO;
static void togglePanel() {
    if (!gPanelOpen) {
        gPanelOpen = YES;
        [UIView animateWithDuration:0.35 delay:0 usingSpringWithDamping:0.75 initialSpringVelocity:0.6 options:0 animations:^{
            gPanelView.alpha = 1;
            gPanelView.transform = CGAffineTransformIdentity;
        } completion:nil];
    } else {
        gPanelOpen = NO;
        [UIView animateWithDuration:0.25 animations:^{
            gPanelView.alpha = 0;
            gPanelView.transform = CGAffineTransformMakeScale(0.85, 0.85);
        } completion:nil];
    }
}

// ============================================================
// MCUIHandler 扩展
// ============================================================
@implementation MCUIHandler (Actions)
- (void)segChanged {
    NSInteger i = gSegment.selectedSegmentIndex;
    gTexturePage.hidden = (i != 0);
    gMusicPage.hidden = (i != 1);
    gNetEasePage.hidden = (i != 2);
}
- (void)texSwitch:(UISwitch *)sw {
    gTextureEnabled = sw.on;
    UILabel *l = [gTexturePage viewWithTag:888];
    l.text = sw.on ? @"已开启" : @"已关闭";
}
- (void)playToggle {
    togglePlay();
    [gPlayBtn setTitle:(gMusicPlayer.isPlaying ? @"⏸️" : @"▶️") forState:UIControlStateNormal];
}
- (void)volumeChanged:(UISlider *)s {
    gMusicVolume = s.value;
    if (gMusicPlayer) gMusicPlayer.volume = gMusicVolume;
    gStatusLabel.text = [NSString stringWithFormat:@"播放中 · 音量 %.0f%%", gMusicVolume*100];
}
@end

// ============================================================
// 5. 初始化
// ============================================================
%ctor {
    NSLog(@"[MCPlugin] 初始化...");
    setupAudioSession();
    setupTextureHook();
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 3*NSEC_PER_SEC),
                   dispatch_get_main_queue(), ^{
        setupFloatingWindow();
        wireButtons();
    });
}
